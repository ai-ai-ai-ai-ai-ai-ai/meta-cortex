{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meta-Cortex Workbench",
  "identifier": "org.meta-cortex.workbench",
  "build": { "frontendDist": "frontend/dist", "windows": { "staticVCRuntime": false } },
  "app": {
    "windows": [{ "label": "main", "title": "Meta-Cortex Workbench", "width": 1180, "height": 780, "minWidth": 480, "minHeight": 400 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:" }
  },
  "bundle": { "active": false, "icon": [] }
}
