{
  "$defs": {
    "ActiveWork": {
      "description": "Work currently held by an agent, extracted without loading full task documents.",
      "properties": {
        "agent": { "$ref": "#/$defs/AgentId" },
        "blocker": { "$ref": "#/$defs/Blocker" },
        "last_update": { "format": "int64", "type": "integer" },
        "lease": { "$ref": "#/$defs/LeaseHealth" },
        "status": { "$ref": "#/$defs/FlowState" },
        "summary": { "$ref": "#/$defs/Note" },
        "task": { "type": "string" }
      },
      "required": [
        "task",
        "agent",
        "status",
        "lease",
        "blocker",
        "summary",
        "last_update"
      ],
      "type": "object"
    },
    "AgentId": {
      "description": "An agent role scoped to its owning Cortex team.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "role": { "$ref": "#/$defs/GizmoAgent" },
            "team": { "const": "Gizmo", "type": "string" }
          },
          "required": ["team", "role"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "role": { "$ref": "#/$defs/DevelopmentAgent" },
            "team": { "const": "Development", "type": "string" }
          },
          "required": ["team", "role"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "role": { "$ref": "#/$defs/AiAgent" },
            "team": { "const": "Ai", "type": "string" }
          },
          "required": ["team", "role"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "role": { "$ref": "#/$defs/SecurityAgent" },
            "team": { "const": "Security", "type": "string" }
          },
          "required": ["team", "role"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "role": { "$ref": "#/$defs/SreAgent" },
            "team": { "const": "Sre", "type": "string" }
          },
          "required": ["team", "role"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "role": { "$ref": "#/$defs/DeliveryAgent" },
            "team": { "const": "Delivery", "type": "string" }
          },
          "required": ["team", "role"],
          "type": "object"
        }
      ]
    },
    "AiAgent": {
      "enum": ["TechWriter", "TechWriterVerifier"],
      "type": "string"
    },
    "Assignment": {
      "additionalProperties": false,
      "properties": {
        "agent": { "$ref": "#/$defs/AgentId" },
        "attempt": { "format": "int64", "type": "integer" },
        "expires_at": { "format": "int64", "type": "integer" },
        "phase": { "$ref": "#/$defs/Phase" }
      },
      "required": ["agent", "attempt", "expires_at", "phase"],
      "type": "object"
    },
    "Blocker": {
      "description": "Why held work cannot proceed, as its worker recorded it.",
      "oneOf": [
        {
          "properties": { "kind": { "const": "unblocked", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "properties": {
            "kind": { "const": "blocked", "type": "string" },
            "reason": { "$ref": "#/$defs/Note" }
          },
          "required": ["kind", "reason"],
          "type": "object"
        }
      ]
    },
    "Check": {
      "additionalProperties": false,
      "properties": {
        "command": { "$ref": "#/$defs/Note" },
        "evidence": { "$ref": "#/$defs/Note" },
        "outcome": { "$ref": "#/$defs/CheckOutcome" }
      },
      "required": ["command", "outcome", "evidence"],
      "type": "object"
    },
    "CheckOutcome": {
      "enum": ["passed", "failed", "not_run"],
      "type": "string"
    },
    "Checkpoint": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": { "kind": { "const": "unrecorded", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "commit": { "type": "string" },
            "kind": { "const": "git", "type": "string" }
          },
          "required": ["kind", "commit"],
          "type": "object"
        }
      ]
    },
    "Completion": {
      "description": "Finished work over all recorded work; cancelled tasks are closed but not finished.",
      "properties": {
        "cancelled": { "format": "uint64", "minimum": 0, "type": "integer" },
        "finished": { "format": "uint64", "minimum": 0, "type": "integer" },
        "total": { "format": "uint64", "minimum": 0, "type": "integer" }
      },
      "required": ["finished", "cancelled", "total"],
      "type": "object"
    },
    "DeliveryAgent": {
      "enum": ["IntegrationAgent", "PrAgent"],
      "type": "string"
    },
    "DesktopFailure": {
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "Ledger", "type": "string" },
            "message": { "$ref": "#/$defs/Note" }
          },
          "required": ["kind", "message"],
          "type": "object"
        },
        {
          "properties": {
            "kind": { "const": "Runtime", "type": "string" },
            "message": { "$ref": "#/$defs/Note" }
          },
          "required": ["kind", "message"],
          "type": "object"
        },
        {
          "properties": {
            "kind": { "const": "Native", "type": "string" },
            "message": { "$ref": "#/$defs/Note" }
          },
          "required": ["kind", "message"],
          "type": "object"
        }
      ]
    },
    "DesktopReply": {
      "description": "The most recently active features with their totals, held work, outcomes and pull requests.",
      "properties": { "features": { "$ref": "#/$defs/Page" } },
      "required": ["features"],
      "type": "object"
    },
    "DevelopmentAgent": {
      "enum": [
        "RustDev",
        "RustRefactoring",
        "RustVerifier",
        "TypescriptDev",
        "TypescriptVerifier",
        "WebDesigner"
      ],
      "type": "string"
    },
    "ElapsedMillis": {
      "description": "Nonnegative recorded elapsed milliseconds, independent of display rounding.",
      "format": "int64",
      "type": "integer"
    },
    "EventKind": {
      "enum": [
        "created",
        "claimed",
        "assigned",
        "heartbeat",
        "progress",
        "checkpoint",
        "ready",
        "integrated",
        "completed",
        "requeued",
        "cancelled"
      ],
      "type": "string"
    },
    "Feature": {
      "additionalProperties": false,
      "properties": {
        "branch": { "type": "string" },
        "id": { "type": "string" },
        "objective": { "$ref": "#/$defs/Note" },
        "version": { "format": "int64", "type": "integer" },
        "worktree": { "type": "string" }
      },
      "required": ["version", "id", "objective", "branch", "worktree"],
      "type": "object"
    },
    "FeatureActivity": {
      "description": "Task activity bounds, not feature lifecycle events (which are not stored).",
      "oneOf": [
        {
          "properties": { "kind": { "const": "empty", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "properties": {
            "first_task_at": { "format": "int64", "type": "integer" },
            "kind": { "const": "recorded", "type": "string" },
            "last_activity_at": { "format": "int64", "type": "integer" }
          },
          "required": ["kind", "first_task_at", "last_activity_at"],
          "type": "object"
        }
      ]
    },
    "FeatureOutcome": {
      "description": "A task no other recorded task depends on: something the feature delivers.",
      "properties": {
        "last_update": { "format": "int64", "type": "integer" },
        "status": { "$ref": "#/$defs/FlowState" },
        "task": { "type": "string" }
      },
      "required": ["task", "status", "last_update"],
      "type": "object"
    },
    "FeatureSummary": {
      "properties": {
        "active": {
          "items": { "$ref": "#/$defs/ActiveWork" },
          "type": "array"
        },
        "actors": {
          "description": "Distinct roles that actually authored saved events.",
          "items": { "$ref": "#/$defs/AgentId" },
          "type": "array"
        },
        "feature": { "$ref": "#/$defs/Feature" },
        "latest_delivery": { "$ref": "#/$defs/LatestDelivery" },
        "outcomes": {
          "description": "Live tasks no other task depends on, most recently updated first.",
          "items": { "$ref": "#/$defs/FeatureOutcome" },
          "type": "array"
        },
        "pull_requests": {
          "description": "Pull requests recorded in task progress extensions, most often recorded first.",
          "items": { "$ref": "#/$defs/PullRequest" },
          "type": "array"
        },
        "totals": { "$ref": "#/$defs/WorkflowTotals" }
      },
      "required": [
        "feature",
        "totals",
        "active",
        "actors",
        "pull_requests",
        "outcomes",
        "latest_delivery"
      ],
      "type": "object"
    },
    "FeatureWorkflow": {
      "properties": {
        "chapters": {
          "items": { "$ref": "#/$defs/TaskChapter" },
          "type": "array"
        },
        "feature": { "type": "string" },
        "timeline": { "$ref": "#/$defs/RecordedTimeline" },
        "timing": { "$ref": "#/$defs/WorkflowTiming" }
      },
      "required": ["timeline", "feature", "chapters", "timing"],
      "type": "object"
    },
    "FeedEntry": {
      "properties": {
        "actor": { "$ref": "#/$defs/AgentId" },
        "at": { "format": "int64", "type": "integer" },
        "checkpoint": { "$ref": "#/$defs/Checkpoint" },
        "evidence": {
          "description": "Only evidence changed since the previous revision of this task.",
          "items": { "$ref": "#/$defs/Progress" },
          "type": "array"
        },
        "kind": { "$ref": "#/$defs/EventKind" },
        "note": { "$ref": "#/$defs/Note" },
        "objective": { "$ref": "#/$defs/Note" },
        "ownership": {
          "$ref": "#/$defs/TaskOwnership",
          "description": "Ownership recorded in this event snapshot, independent of its actor."
        },
        "revision": { "format": "int64", "type": "integer" },
        "state": {
          "$ref": "#/$defs/TaskState",
          "description": "Task state recorded in this event snapshot, independent of later revisions."
        },
        "summary": { "$ref": "#/$defs/Note" },
        "worker": {
          "$ref": "#/$defs/WorkerIdentity",
          "description": "Worker identity from this event snapshot, never inferred from its actor."
        }
      },
      "required": [
        "objective",
        "worker",
        "kind",
        "actor",
        "ownership",
        "state",
        "note",
        "summary",
        "at",
        "revision",
        "evidence",
        "checkpoint"
      ],
      "type": "object"
    },
    "FlowCount": {
      "properties": {
        "count": { "format": "uint64", "minimum": 0, "type": "integer" },
        "state": { "$ref": "#/$defs/FlowState" }
      },
      "required": ["state", "count"],
      "type": "object"
    },
    "FlowState": {
      "description": "One observable workflow state; `Working` and `Blocked` split the active assignment phase.",
      "enum": [
        "queued",
        "working",
        "blocked",
        "ready",
        "integrated",
        "completed",
        "cancelled"
      ],
      "type": "string"
    },
    "GizmoAgent": { "enum": ["GizmoPrime", "Gizmo"], "type": "string" },
    "LatestDelivery": {
      "description": "The task a coordinator most recently integrated or completed.",
      "oneOf": [
        {
          "properties": { "kind": { "const": "nothing", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "properties": {
            "at": { "format": "int64", "type": "integer" },
            "kind": { "const": "delivered", "type": "string" },
            "status": { "$ref": "#/$defs/FlowState" },
            "task": { "type": "string" }
          },
          "required": ["kind", "task", "status", "at"],
          "type": "object"
        }
      ]
    },
    "LeaseHealth": {
      "enum": ["current", "expired", "not_running"],
      "type": "string"
    },
    "Note": { "type": "string" },
    "Page": {
      "description": "A page of bounded records. Each operation releases its connection before returning.",
      "properties": {
        "end": { "$ref": "#/$defs/PageEnd" },
        "records": {
          "items": { "$ref": "#/$defs/FeatureSummary" },
          "type": "array"
        }
      },
      "required": ["records", "end"],
      "type": "object"
    },
    "PageEnd": { "enum": ["Complete", "More"], "type": "string" },
    "Phase": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": { "kind": { "const": "working", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "blocked", "type": "string" },
            "reason": { "$ref": "#/$defs/Note" }
          },
          "required": ["kind", "reason"],
          "type": "object"
        }
      ]
    },
    "Progress": {
      "additionalProperties": false,
      "properties": {
        "checks": { "items": { "$ref": "#/$defs/Check" }, "type": "array" },
        "extensions": {
          "additionalProperties": true,
          "default": {},
          "description": "Task-specific data only. Coordination never interprets these keys.",
          "type": "object"
        },
        "findings": { "items": { "$ref": "#/$defs/Note" }, "type": "array" },
        "next_steps": { "items": { "$ref": "#/$defs/Note" }, "type": "array" },
        "summary": { "$ref": "#/$defs/Note" }
      },
      "required": ["summary", "findings", "next_steps", "checks"],
      "type": "object"
    },
    "PullRequest": {
      "description": "A pull request recorded by at least one task, with the tasks that recorded it.",
      "properties": {
        "number": { "format": "uint64", "minimum": 0, "type": "integer" },
        "recorded_at": {
          "description": "Latest update of a task that records this pull request.",
          "format": "int64",
          "type": "integer"
        },
        "repository": {
          "description": "`owner/repository` as written in the link.",
          "type": "string"
        },
        "tasks": {
          "description": "Tasks whose current progress records this pull request, most recent first.",
          "items": { "type": "string" },
          "type": "array"
        },
        "url": {
          "description": "Canonical `https://host/owner/repository/pull/number` link.",
          "type": "string"
        }
      },
      "required": ["url", "repository", "number", "tasks", "recorded_at"],
      "type": "object"
    },
    "RecordedRole": {
      "oneOf": [
        {
          "properties": { "kind": { "const": "Unrecorded", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "properties": {
            "agent": { "$ref": "#/$defs/AgentId" },
            "kind": { "const": "Recorded", "type": "string" }
          },
          "required": ["kind", "agent"],
          "type": "object"
        }
      ]
    },
    "RecordedTimeline": {
      "properties": {
        "chapter_order": { "items": { "type": "string" }, "type": "array" },
        "extent": { "$ref": "#/$defs/TimelineExtent" },
        "groups": {
          "items": { "$ref": "#/$defs/TimelineGroup" },
          "type": "array"
        }
      },
      "required": ["extent", "groups", "chapter_order"],
      "type": "object"
    },
    "RecordedWindow": {
      "properties": {
        "duration_ms": { "$ref": "#/$defs/ElapsedMillis" },
        "end": { "format": "int64", "type": "integer" },
        "objective": { "$ref": "#/$defs/Note" },
        "revision": { "format": "int64", "type": "integer" },
        "role": { "$ref": "#/$defs/RecordedRole" },
        "start": { "format": "int64", "type": "integer" },
        "state": { "$ref": "#/$defs/TaskState" },
        "status": { "$ref": "#/$defs/FlowState" },
        "summary": { "$ref": "#/$defs/Note" },
        "summary_revision": { "format": "int64", "type": "integer" },
        "task": { "type": "string" },
        "worker": { "$ref": "#/$defs/WorkerIdentity" }
      },
      "required": [
        "task",
        "objective",
        "revision",
        "summary_revision",
        "start",
        "end",
        "duration_ms",
        "state",
        "status",
        "worker",
        "role",
        "summary"
      ],
      "type": "object"
    },
    "ReportingTarget": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": { "kind": { "const": "Host", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "coordinator": { "$ref": "#/$defs/GizmoAgent" },
            "kind": { "const": "Gizmo", "type": "string" }
          },
          "required": ["kind", "coordinator"],
          "type": "object"
        }
      ]
    },
    "SecurityAgent": { "enum": ["SecurityAgent"], "type": "string" },
    "SreAgent": {
      "enum": ["CicdAgent", "DockerSpecialist", "KubernetesSpecialist"],
      "type": "string"
    },
    "TaskAssignment": {
      "additionalProperties": false,
      "description": "The intended owner and reporting line survive every task state and attempt.",
      "properties": {
        "agent": { "$ref": "#/$defs/AgentId" },
        "reports_to": { "$ref": "#/$defs/ReportingTarget" }
      },
      "required": ["agent", "reports_to"],
      "type": "object"
    },
    "TaskChapter": {
      "properties": {
        "entries": {
          "items": { "$ref": "#/$defs/FeedEntry" },
          "type": "array"
        },
        "role": { "$ref": "#/$defs/RecordedRole" },
        "status": { "$ref": "#/$defs/FlowState" },
        "task": { "$ref": "#/$defs/TaskV3" }
      },
      "required": ["task", "role", "status", "entries"],
      "type": "object"
    },
    "TaskCommon": {
      "additionalProperties": false,
      "description": "Shared task fields in V2 and later records.\nKeep this shape stable for retained readers; changed field meanings need a new type.",
      "properties": {
        "acceptance": { "items": { "$ref": "#/$defs/Note" }, "type": "array" },
        "attempt": { "format": "int64", "type": "integer" },
        "checkpoint": { "$ref": "#/$defs/Checkpoint" },
        "created_at": { "format": "int64", "type": "integer" },
        "dependencies": { "items": { "type": "string" }, "type": "array" },
        "feature": { "type": "string" },
        "id": { "type": "string" },
        "last_progress": { "format": "int64", "type": "integer" },
        "last_update": { "format": "int64", "type": "integer" },
        "objective": { "$ref": "#/$defs/Note" },
        "progress": { "$ref": "#/$defs/Progress" },
        "revision": { "format": "int64", "type": "integer" }
      },
      "required": [
        "id",
        "feature",
        "objective",
        "acceptance",
        "dependencies",
        "revision",
        "attempt",
        "created_at",
        "last_update",
        "last_progress",
        "checkpoint",
        "progress"
      ],
      "type": "object"
    },
    "TaskOwnership": {
      "description": "V1 tasks did not record an intended owner or reporting line.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": { "kind": { "const": "Unrecorded", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assignment": { "$ref": "#/$defs/TaskAssignment" },
            "kind": { "const": "Assigned", "type": "string" }
          },
          "required": ["kind", "assignment"],
          "type": "object"
        }
      ]
    },
    "TaskRecordVersion": {
      "const": 3,
      "description": "Current task shape. V1 payloads are decoded by the separate legacy task record.",
      "format": "int64",
      "type": "integer"
    },
    "TaskState": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": { "kind": { "const": "queued", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "assignment": { "$ref": "#/$defs/Assignment" },
            "kind": { "const": "active", "type": "string" }
          },
          "required": ["kind", "assignment"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "agent": { "$ref": "#/$defs/AgentId" },
            "attempt": { "format": "int64", "type": "integer" },
            "kind": { "const": "ready", "type": "string" }
          },
          "required": ["kind", "agent", "attempt"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "commit": { "type": "string" },
            "kind": { "const": "integrated", "type": "string" }
          },
          "required": ["kind", "commit"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "agent": { "$ref": "#/$defs/AgentId" },
            "attempt": { "format": "int64", "type": "integer" },
            "kind": { "const": "completed", "type": "string" }
          },
          "required": ["kind", "agent", "attempt"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "cancelled", "type": "string" },
            "reason": { "$ref": "#/$defs/Note" }
          },
          "required": ["kind", "reason"],
          "type": "object"
        }
      ]
    },
    "TaskV3": {
      "additionalProperties": false,
      "properties": {
        "common": { "$ref": "#/$defs/TaskCommon" },
        "ownership": { "$ref": "#/$defs/TaskOwnership" },
        "state": { "$ref": "#/$defs/TaskState" },
        "version": { "$ref": "#/$defs/TaskRecordVersion" },
        "worker": { "$ref": "#/$defs/WorkerIdentity" },
        "workspace": { "$ref": "#/$defs/Workspace" }
      },
      "required": [
        "version",
        "worker",
        "common",
        "ownership",
        "workspace",
        "state"
      ],
      "type": "object"
    },
    "TimelineExtent": {
      "oneOf": [
        {
          "properties": { "kind": { "const": "Empty", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "properties": {
            "finished": { "format": "int64", "type": "integer" },
            "kind": { "const": "Recorded", "type": "string" },
            "started": { "format": "int64", "type": "integer" }
          },
          "required": ["kind", "started", "finished"],
          "type": "object"
        }
      ]
    },
    "TimelineGroup": {
      "properties": {
        "identity": { "$ref": "#/$defs/TimelineGroupIdentity" },
        "order": { "$ref": "#/$defs/TimelineOrder" },
        "roles": {
          "items": { "$ref": "#/$defs/RecordedRole" },
          "type": "array"
        },
        "tasks": { "items": { "type": "string" }, "type": "array" },
        "windows": {
          "items": { "$ref": "#/$defs/RecordedWindow" },
          "type": "array"
        }
      },
      "required": ["identity", "roles", "tasks", "windows", "order"],
      "type": "object"
    },
    "TimelineGroupIdentity": {
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "RecordedWorker", "type": "string" },
            "worker_id": { "$ref": "#/$defs/WorkerId" }
          },
          "required": ["kind", "worker_id"],
          "type": "object"
        },
        {
          "properties": {
            "kind": { "const": "RoleHistory", "type": "string" },
            "role": { "$ref": "#/$defs/RecordedRole" }
          },
          "required": ["kind", "role"],
          "type": "object"
        }
      ]
    },
    "TimelineOrder": {
      "oneOf": [
        {
          "properties": {
            "at": { "format": "int64", "type": "integer" },
            "kind": { "const": "Recorded", "type": "string" }
          },
          "required": ["kind", "at"],
          "type": "object"
        },
        {
          "properties": { "kind": { "const": "Unrecorded", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        }
      ]
    },
    "WorkerId": {
      "description": "Stable identity chosen once by the host worker, then reused across its tasks.",
      "format": "uuid",
      "type": "string"
    },
    "WorkerIdentity": {
      "description": "Recorded host worker identity; legacy snapshots never invent one from a role.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": { "kind": { "const": "Unrecorded", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "Recorded", "type": "string" },
            "worker_id": { "$ref": "#/$defs/WorkerId" }
          },
          "required": ["kind", "worker_id"],
          "type": "object"
        }
      ]
    },
    "WorkflowCondition": {
      "description": "The single headline an observer needs first; attention outranks progress.",
      "enum": ["empty", "attention", "active", "waiting", "finished"],
      "type": "string"
    },
    "WorkflowTiming": {
      "oneOf": [
        {
          "properties": { "kind": { "const": "Empty", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "properties": {
            "kind": { "const": "Running", "type": "string" },
            "started": { "format": "int64", "type": "integer" }
          },
          "required": ["kind", "started"],
          "type": "object"
        },
        {
          "properties": {
            "finished": { "format": "int64", "type": "integer" },
            "kind": { "const": "Finished", "type": "string" },
            "started": { "format": "int64", "type": "integer" }
          },
          "required": ["kind", "started", "finished"],
          "type": "object"
        }
      ]
    },
    "WorkflowTotals": {
      "properties": {
        "activity": { "$ref": "#/$defs/FeatureActivity" },
        "completion": { "$ref": "#/$defs/Completion" },
        "condition": { "$ref": "#/$defs/WorkflowCondition" },
        "counts": { "items": { "$ref": "#/$defs/FlowCount" }, "type": "array" },
        "stalled": {
          "description": "Active tasks whose lease expired before the observation.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["counts", "completion", "stalled", "activity", "condition"],
      "type": "object"
    },
    "Workspace": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": { "kind": { "const": "read_only", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Operate on the feature's existing worktree, without a worker checkpoint.",
          "properties": { "kind": { "const": "feature", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "branch": { "type": "string" },
            "kind": { "const": "git", "type": "string" },
            "path": { "type": "string" }
          },
          "required": ["kind", "branch", "path"],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "failure": { "$ref": "#/$defs/DesktopFailure" },
    "reply": { "$ref": "#/$defs/DesktopReply" },
    "workflow": { "$ref": "#/$defs/FeatureWorkflow" }
  },
  "required": ["reply", "workflow", "failure"],
  "title": "DesktopContract",
  "type": "object"
}
