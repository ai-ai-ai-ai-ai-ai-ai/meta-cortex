{
  "$defs": {
    "ActiveWork": {
      "description": "Work currently held by an agent, extracted without loading full task documents.",
      "properties": {
        "agent": { "$ref": "#/$defs/AgentId" },
        "blocker": { "$ref": "#/$defs/Blocker" },
        "last_update": { "format": "int64", "type": "integer" },
        "lease": { "$ref": "#/$defs/LeaseHealth" },
        "status": { "$ref": "#/$defs/FlowState" },
        "summary": { "$ref": "#/$defs/Note" },
        "task": { "type": "string" }
      },
      "required": [
        "task",
        "agent",
        "status",
        "lease",
        "blocker",
        "summary",
        "last_update"
      ],
      "type": "object"
    },
    "AgentId": {
      "description": "An agent role scoped to its owning Cortex team.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "role": { "$ref": "#/$defs/GizmoAgent" },
            "team": { "const": "Gizmo", "type": "string" }
          },
          "required": ["team", "role"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "role": { "$ref": "#/$defs/DevelopmentAgent" },
            "team": { "const": "Development", "type": "string" }
          },
          "required": ["team", "role"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "role": { "$ref": "#/$defs/AiAgent" },
            "team": { "const": "Ai", "type": "string" }
          },
          "required": ["team", "role"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "role": { "$ref": "#/$defs/SecurityAgent" },
            "team": { "const": "Security", "type": "string" }
          },
          "required": ["team", "role"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "role": { "$ref": "#/$defs/SreAgent" },
            "team": { "const": "Sre", "type": "string" }
          },
          "required": ["team", "role"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "role": { "$ref": "#/$defs/DeliveryAgent" },
            "team": { "const": "Delivery", "type": "string" }
          },
          "required": ["team", "role"],
          "type": "object"
        }
      ]
    },
    "AiAgent": {
      "enum": ["TechWriter", "TechWriterVerifier"],
      "type": "string"
    },
    "Blocker": {
      "description": "Why held work cannot proceed, as its worker recorded it.",
      "oneOf": [
        {
          "properties": { "kind": { "const": "unblocked", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "properties": {
            "kind": { "const": "blocked", "type": "string" },
            "reason": { "$ref": "#/$defs/Note" }
          },
          "required": ["kind", "reason"],
          "type": "object"
        }
      ]
    },
    "Completion": {
      "description": "Finished work over all recorded work; cancelled tasks are closed but not finished.",
      "properties": {
        "cancelled": { "format": "uint64", "minimum": 0, "type": "integer" },
        "finished": { "format": "uint64", "minimum": 0, "type": "integer" },
        "total": { "format": "uint64", "minimum": 0, "type": "integer" }
      },
      "required": ["finished", "cancelled", "total"],
      "type": "object"
    },
    "DeliveryAgent": {
      "enum": ["IntegrationAgent", "PrAgent"],
      "type": "string"
    },
    "DesktopFailure": {
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "Ledger", "type": "string" },
            "message": { "$ref": "#/$defs/Note" }
          },
          "required": ["kind", "message"],
          "type": "object"
        },
        {
          "properties": {
            "kind": { "const": "Runtime", "type": "string" },
            "message": { "$ref": "#/$defs/Note" }
          },
          "required": ["kind", "message"],
          "type": "object"
        },
        {
          "properties": {
            "kind": { "const": "Native", "type": "string" },
            "message": { "$ref": "#/$defs/Note" }
          },
          "required": ["kind", "message"],
          "type": "object"
        }
      ]
    },
    "DesktopReply": {
      "description": "The most recently active features with their totals, held work, outcomes and pull requests.",
      "properties": { "features": { "$ref": "#/$defs/Page" } },
      "required": ["features"],
      "type": "object"
    },
    "DevelopmentAgent": {
      "enum": [
        "RustDev",
        "RustRefactoring",
        "RustVerifier",
        "TypescriptDev",
        "TypescriptVerifier",
        "WebDesigner"
      ],
      "type": "string"
    },
    "Feature": {
      "additionalProperties": false,
      "properties": {
        "branch": { "type": "string" },
        "id": { "type": "string" },
        "objective": { "$ref": "#/$defs/Note" },
        "version": { "format": "int64", "type": "integer" },
        "worktree": { "type": "string" }
      },
      "required": ["version", "id", "objective", "branch", "worktree"],
      "type": "object"
    },
    "FeatureActivity": {
      "description": "Task activity bounds, not feature lifecycle events (which are not stored).",
      "oneOf": [
        {
          "properties": { "kind": { "const": "empty", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "properties": {
            "first_task_at": { "format": "int64", "type": "integer" },
            "kind": { "const": "recorded", "type": "string" },
            "last_activity_at": { "format": "int64", "type": "integer" }
          },
          "required": ["kind", "first_task_at", "last_activity_at"],
          "type": "object"
        }
      ]
    },
    "FeatureOutcome": {
      "description": "A task no other recorded task depends on: something the feature delivers.",
      "properties": {
        "last_update": { "format": "int64", "type": "integer" },
        "status": { "$ref": "#/$defs/FlowState" },
        "task": { "type": "string" }
      },
      "required": ["task", "status", "last_update"],
      "type": "object"
    },
    "FeatureSummary": {
      "properties": {
        "active": {
          "items": { "$ref": "#/$defs/ActiveWork" },
          "type": "array"
        },
        "feature": { "$ref": "#/$defs/Feature" },
        "latest_delivery": { "$ref": "#/$defs/LatestDelivery" },
        "outcomes": {
          "description": "Live tasks no other task depends on, most recently updated first.",
          "items": { "$ref": "#/$defs/FeatureOutcome" },
          "type": "array"
        },
        "pull_requests": {
          "description": "Pull requests recorded in task progress extensions, most often recorded first.",
          "items": { "$ref": "#/$defs/PullRequest" },
          "type": "array"
        },
        "totals": { "$ref": "#/$defs/WorkflowTotals" }
      },
      "required": [
        "feature",
        "totals",
        "active",
        "pull_requests",
        "outcomes",
        "latest_delivery"
      ],
      "type": "object"
    },
    "FlowCount": {
      "properties": {
        "count": { "format": "uint64", "minimum": 0, "type": "integer" },
        "state": { "$ref": "#/$defs/FlowState" }
      },
      "required": ["state", "count"],
      "type": "object"
    },
    "FlowState": {
      "description": "One observable workflow state; `Working` and `Blocked` split the active assignment phase.",
      "enum": [
        "queued",
        "working",
        "blocked",
        "ready",
        "integrated",
        "completed",
        "cancelled"
      ],
      "type": "string"
    },
    "GizmoAgent": { "enum": ["GizmoPrime", "Gizmo"], "type": "string" },
    "LatestDelivery": {
      "description": "The task a coordinator most recently integrated or completed.",
      "oneOf": [
        {
          "properties": { "kind": { "const": "nothing", "type": "string" } },
          "required": ["kind"],
          "type": "object"
        },
        {
          "properties": {
            "at": { "format": "int64", "type": "integer" },
            "kind": { "const": "delivered", "type": "string" },
            "status": { "$ref": "#/$defs/FlowState" },
            "task": { "type": "string" }
          },
          "required": ["kind", "task", "status", "at"],
          "type": "object"
        }
      ]
    },
    "LeaseHealth": {
      "enum": ["current", "expired", "not_running"],
      "type": "string"
    },
    "Note": { "type": "string" },
    "Page": {
      "description": "A page of bounded records. Each operation releases its connection before returning.",
      "properties": {
        "end": { "$ref": "#/$defs/PageEnd" },
        "records": {
          "items": { "$ref": "#/$defs/FeatureSummary" },
          "type": "array"
        }
      },
      "required": ["records", "end"],
      "type": "object"
    },
    "PageEnd": { "enum": ["Complete", "More"], "type": "string" },
    "PullRequest": {
      "description": "A pull request recorded by at least one task, with the tasks that recorded it.",
      "properties": {
        "number": { "format": "uint64", "minimum": 0, "type": "integer" },
        "recorded_at": {
          "description": "Latest update of a task that records this pull request.",
          "format": "int64",
          "type": "integer"
        },
        "repository": {
          "description": "`owner/repository` as written in the link.",
          "type": "string"
        },
        "tasks": {
          "description": "Tasks whose current progress records this pull request, most recent first.",
          "items": { "type": "string" },
          "type": "array"
        },
        "url": {
          "description": "Canonical `https://host/owner/repository/pull/number` link.",
          "type": "string"
        }
      },
      "required": ["url", "repository", "number", "tasks", "recorded_at"],
      "type": "object"
    },
    "SecurityAgent": { "enum": ["SecurityAgent"], "type": "string" },
    "SreAgent": {
      "enum": ["CicdAgent", "DockerSpecialist", "KubernetesSpecialist"],
      "type": "string"
    },
    "WorkflowCondition": {
      "description": "The single headline an observer needs first; attention outranks progress.",
      "enum": ["empty", "attention", "active", "waiting", "finished"],
      "type": "string"
    },
    "WorkflowTotals": {
      "properties": {
        "activity": { "$ref": "#/$defs/FeatureActivity" },
        "completion": { "$ref": "#/$defs/Completion" },
        "condition": { "$ref": "#/$defs/WorkflowCondition" },
        "counts": { "items": { "$ref": "#/$defs/FlowCount" }, "type": "array" },
        "stalled": {
          "description": "Active tasks whose lease expired before the observation.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["counts", "completion", "stalled", "activity", "condition"],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "failure": { "$ref": "#/$defs/DesktopFailure" },
    "reply": { "$ref": "#/$defs/DesktopReply" }
  },
  "required": ["reply", "failure"],
  "title": "DesktopContract",
  "type": "object"
}
