{
  "name": "@meta-cortex/dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "bun run typecheck && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun tools/checks/check.ts typecheck",
    "lint": "bun tools/checks/check.ts lint",
    "verify": "bun run format:check && bun run typecheck && bun run lint && knip",
    "test": "vitest run",
    "generate:contracts": "bun tools/generate-contracts.ts && prettier --write contracts.schema.json src/contracts.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "effect": "4.1.0",
    "svelte": "5.57.3",
    "markdown-it": "15.0.3",
    "markdown-it-anchor": "10.0.0",
    "mermaid": "12.2.0"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.1.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@lucide/svelte": "1.64.0",
    "@rsvelte/lint": "0.12.6",
    "@rsvelte/svelte-check": "0.5.32",
    "@rsvelte/svelte2tsx": "0.2.28",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "cn": "0.5.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "knip": "6.44.0",
    "oxlint": "1.90.0",
    "oxlint-plugin-eslint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "tailwind-variants": "4.0.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vscode-css-languageservice": "6.3.10",
    "vscode-languageserver-textdocument": "1.0.12"
  }
}
