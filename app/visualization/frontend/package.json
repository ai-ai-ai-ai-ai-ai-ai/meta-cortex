{
  "name": "@meta-cortex/dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "bun run typecheck && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "verify": "bun run format:check && bun run typecheck && bun run lint && knip",
    "test": "vitest run",
    "generate:contracts": "bun tools/generate-contracts.ts && prettier --write contracts.schema.json src/contracts.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "effect": "4.0.0-rc.117",
    "svelte": "5.57.1",
    "markdown-it": "15.0.2",
    "markdown-it-anchor": "10.0.0",
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lucide/svelte": "1.50.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/svelte": "5.4.2",
    "ajv": "8.17.1",
    "cn": "0.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "json-schema-to-typescript": "15.0.4",
    "knip": "5.63.1",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
