  "state_meanings": [
    {
      "state": "queued",
      "meaning": "The task is waiting for a worker claim.",
      "evidence": "The recorded task state is Queued; there is no active claim.",
      "next_step": "The assigned worker claims the task when its prerequisites are satisfied.",
      "qualification": "Assignment and queueing do not prove that a worker has started execution."
    },
    {
      "state": "working",
      "meaning": "The active assignment has its Working phase recorded.",
      "evidence": "A worker claim exists and its recorded phase is Working.",
      "next_step": "The worker records progress, a blocking reason, or a ready handoff.",
      "qualification": "This is recorded coordination state, not a measurement of execution or liveness."
    },
    {
      "state": "blocked",
      "meaning": "The active assignment has a blocking reason recorded.",
      "evidence": "The task snapshot contains the Blocked phase and its reason.",
      "next_step": "Resolve the recorded blocker; the worker can then record further progress.",
      "qualification": "The reason describes the recorded obstacle; this state does not identify an enforced resolver."
    },
    {
      "state": "ready",
      "meaning": "The worker has handed the task off for acceptance or integration.",
      "evidence": "A valid worker update recorded Ready. Git workspaces require a checkpoint and readiness checks.",
      "next_step": "The coordinator reviews the handoff and selects the supported integration or completion transition.",
      "qualification": "Ready is a handoff, not final acceptance. Framework policy assigns review responsibilities; the state alone does not prove review occurred."
    },
    {
      "state": "integrated",
      "meaning": "A Ready task in a Git or ReadOnly workspace was accepted against the feature branch HEAD.",
      "evidence": "The feature worktree was clean on its recorded branch, the supplied commit equaled HEAD, and a recorded Git checkpoint was an ancestor when present. An Unrecorded checkpoint is allowed.",
      "next_step": "This task is terminal. Continue any remaining feature review or delivery work through its own tasks.",
      "qualification": "Recording Integrated does not perform a merge. Framework policy names IntegrationAgent, but the API does not enforce that specific role. It does not prove CI, PR merge, deployment, or feature acceptance; Integrated cannot transition to Completed."
    },
    {
      "state": "completed",
      "meaning": "The coordinator accepted a Ready task in a ReadOnly or Feature workspace.",
      "evidence": "The completion transition requires Ready and a non-Git workspace.",
      "next_step": "This task is terminal. Continue any remaining feature work through its own tasks.",
      "qualification": "Completed is an alternative terminal outcome to Integrated, not a stage after it. Git write tasks must use integration; task completion alone does not prove feature acceptance or deployment."
    },
    {
      "state": "cancelled",
      "meaning": "The task was stopped with a cancellation reason.",
      "evidence": "A queued, active, or ready task was cancelled and its reason was recorded.",
      "next_step": "This task is terminal. The coordinator decides whether separate replacement work is needed.",
      "qualification": "Cancellation is not successful completion or integration."
    }
  ],
