{
  "rules": {
    "eslint-js/no-dupe-args": [2],
    "no-undef": [
      2,
      {
        "typeof": false
      }
    ],
    "eslint-js/constructor-super": [2],
    "eslint-js/getter-return": [
      2,
      {
        "allowImplicit": false
      }
    ],
    "eslint-js/no-class-assign": [2],
    "eslint-js/no-const-assign": [2],
    "eslint-js/no-dupe-class-members": [2],
    "eslint-js/no-dupe-keys": [2],
    "eslint-js/no-func-assign": [2],
    "eslint-js/no-import-assign": [2],
    "eslint-js/no-new-native-nonconstructor": [2],
    "eslint-js/no-obj-calls": [2],
    "eslint-js/no-redeclare": [
      2,
      {
        "builtinGlobals": true
      }
    ],
    "eslint-js/no-setter-return": [2],
    "eslint-js/no-this-before-super": [2],
    "eslint-js/no-unreachable": [2],
    "eslint-js/no-unsafe-negation": [
      2,
      {
        "enforceForOrderingRelations": false
      }
    ],
    "eslint-js/no-with": [2],
    "eslint-js/for-direction": [2],
    "eslint-js/no-async-promise-executor": [2],
    "eslint-js/no-debugger": [2]
  },
  "ignorePatterns": [],
  "globals": {
    "AggregateError": false,
    "Array": false,
    "ArrayBuffer": false,
    "AsyncDisposableStack": false,
    "Atomics": false,
    "BigInt": false,
    "BigInt64Array": false,
    "BigUint64Array": false,
    "Boolean": false,
    "DataView": false,
    "Date": false,
    "decodeURI": false,
    "decodeURIComponent": false,
    "DisposableStack": false,
    "encodeURI": false,
    "encodeURIComponent": false,
    "Error": false,
    "escape": false,
    "eval": false,
    "EvalError": false,
    "FinalizationRegistry": false,
    "Float16Array": false,
    "Float32Array": false,
    "Float64Array": false,
    "Function": false,
    "globalThis": false,
    "Infinity": false,
    "Int16Array": false,
    "Int32Array": false,
    "Int8Array": false,
    "Intl": false,
    "isFinite": false,
    "isNaN": false,
    "Iterator": false,
    "JSON": false,
    "Map": false,
    "Math": false,
    "NaN": false,
    "Number": false,
    "Object": false,
    "parseFloat": false,
    "parseInt": false,
    "Promise": false,
    "Proxy": false,
    "RangeError": false,
    "ReferenceError": false,
    "Reflect": false,
    "RegExp": false,
    "Set": false,
    "SharedArrayBuffer": false,
    "String": false,
    "SuppressedError": false,
    "Symbol": false,
    "SyntaxError": false,
    "TypeError": false,
    "Uint16Array": false,
    "Uint32Array": false,
    "Uint8Array": false,
    "Uint8ClampedArray": false,
    "undefined": false,
    "unescape": false,
    "URIError": false,
    "WeakMap": false,
    "WeakRef": false,
    "WeakSet": false,
    "$props": false,
    "$state": false,
    "$derived": false,
    "$effect": false,
    "$inspect": false,
    "$bindable": false,
    "$host": false
  },
  "extends": ["./oxlint-base.json"],
  "env": {
    "browser": true,
    "node": true
  },
  "jsPlugins": [
    {
      "name": "eslint-js",
      "specifier": "oxlint-plugin-eslint"
    }
  ],
  "categories": {
    "correctness": "off"
  },
  "plugins": ["typescript"]
}
