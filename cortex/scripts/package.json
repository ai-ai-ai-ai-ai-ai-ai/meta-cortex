{
  "name": "@meta-cortex/scripts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test src/test",
    "format": "prettier --write src package.json tsconfig.json .oxlintrc.json \"../**/*.context.yaml\" \"../**/AGENTS.yaml\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check src package.json tsconfig.json .oxlintrc.json \"../**/*.context.yaml\" \"../**/AGENTS.yaml\" --no-error-on-unmatched-pattern",
    "verify": "bun run format:check && bun run lint && bun run check && bun test src/test && cd .. && bun run context:check",
    "lint": "oxlint --type-aware --max-warnings 0 src"
  },
  "dependencies": {
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "7.0.2",
    "prettier": "3.9.10",
    "yaml": "2.9.1",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "oxlint-plugin-eslint": "1.90.0"
  }
}
