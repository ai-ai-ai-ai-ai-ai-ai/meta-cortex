{
  "name": "@meta-cortex/scripts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test src/test",
    "format": "prettier --write src package.json tsconfig.json eslint.config.js \"../**/*.context.yaml\" \"../**/AGENTS.yaml\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check src package.json tsconfig.json eslint.config.js \"../**/*.context.yaml\" \"../**/AGENTS.yaml\" --no-error-on-unmatched-pattern",
    "verify": "bun run format:check && bun run lint && bun run check && bun test src/test && cd .. && bun run context:check",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "6.0.3",
    "prettier": "3.9.10",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  }
}
