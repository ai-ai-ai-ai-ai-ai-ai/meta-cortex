{
  "name": "@meta-cortex/context-engineering",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test src/test",
    "format": "prettier --write src package.json tsconfig.json eslint.config.js remark.config.json",
    "format:check": "prettier --check src package.json tsconfig.json eslint.config.js remark.config.json",
    "verify": "bun run format:check && bun run lint && bun run check && bun test src/test",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "effect": "4.0.0-rc.117",
    "globby": "16.2.4",
    "mdast-util-to-string": "4.0.0",
    "remark-cli": "12.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-lint": "10.0.1",
    "remark-lint-no-duplicate-definitions": "4.0.1",
    "remark-lint-no-html": "4.0.1",
    "remark-lint-no-undefined-references": "5.0.2",
    "remark-validate-links": "13.1.0",
    "unified": "11.0.5",
    "unist-util-select": "5.1.0",
    "vfile": "6.0.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/mdast": "4.0.4",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0"
  }
}
