{
  "name": "@meta-cortex/user-input",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tools": "bun src/ts/cli.ts",
    "check": "tsc --noEmit",
    "test": "bun test src/test",
    "format": "prettier --write src package.json tsconfig.json .oxlintrc.json",
    "format:check": "prettier --check src package.json tsconfig.json .oxlintrc.json",
    "verify": "bun run format:check && bun run lint && bun run check && bun test src/test",
    "lint": "oxlint --type-aware --max-warnings 0 src"
  },
  "dependencies": {
    "effect": "4.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "7.0.2",
    "prettier": "3.9.10",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "oxlint-plugin-eslint": "1.90.0"
  }
}
