{
  "name": "@meta-cortex/user-input",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tools": "bun src/ts/cli.ts",
    "check": "tsc --noEmit",
    "test": "bun test src/test",
    "format": "prettier --write src package.json tsconfig.json eslint.config.js",
    "format:check": "prettier --check src package.json tsconfig.json eslint.config.js",
    "verify": "bun run format:check && bun run lint && bun run check && bun test src/test",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "effect": "4.0.0-rc.117",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "6.0.3",
    "prettier": "3.9.6",
    "eslint": "10.8.1",
    "typescript-eslint": "8.66.0"
  }
}
